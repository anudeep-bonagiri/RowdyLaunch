# Supabase project for the manifest (RSVP) form. Both values are safe to expose.
# Leave blank and the form section does not render.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Apple Wallet passes (optional). Set these on Vercel with scripts/wallet-env.sh.
# Until all five exist, /api/pass reports configured:false and the button stays hidden.
PASS_TYPE_ID=
APPLE_TEAM_ID=
PASS_SIGNER_CERT=
PASS_SIGNER_KEY=
PASS_WWDR_CERT=
